ML_APP_ENV=development
MODEL_VERSION=xgb-fit-v1
MODEL_PATH=app/models/size_recommender.joblib
ML_SERVICE_SHARED_SECRET=FIT
ML_ADMIN_SECRET=

# Timeouts (seconds). 0 disables enforcement.
ML_RECOMMEND_TIMEOUT_SECONDS=3
ML_ANALYZE_TIMEOUT_SECONDS=6

# Payload guards.
ML_MAX_IMAGE_BYTES=3000000
ML_MAX_IMAGE_PIXELS=12000000
ML_MAX_IMAGE_DIMENSION=4096
ML_MAX_LANDMARKS=64
ML_MAX_SIZE_MEASUREMENTS=30

# Per-minute rate limits per (route, client). 0 disables.
ML_RATE_LIMIT_RECOMMEND_PER_MINUTE=120
ML_RATE_LIMIT_ANALYZE_PER_MINUTE=30
ML_RATE_LIMIT_HEALTH_PER_MINUTE=600
ML_RATE_LIMIT_ADMIN_PER_MINUTE=12
ML_RATE_LIMIT_FEEDBACK_PER_MINUTE=240
ML_RATE_LIMIT_FEEDBACK_PER_MINUTE=240

# Logging.
ML_LOG_LEVEL=INFO
ML_LOG_JSON=true

# Comma-separated CORS allow list. Leave empty for server-to-server only.
ML_CORS_ALLOW_ORIGINS=

# Behaviour flags.
ML_WARM_UP_MODEL=true
ML_EXPOSE_ERROR_DETAILS=false

# Recommendation cache. Set ML_RECOMMENDATION_CACHE_SIZE=0 to disable caching.
ML_RECOMMENDATION_CACHE_SIZE=1024
ML_RECOMMENDATION_CACHE_TTL_SECONDS=300

# Prometheus /metrics endpoint.
ML_METRICS_ENABLED=true
ML_METRICS_REQUIRE_SECRET=false

# Model integrity pinning. Leave empty to disable that specific check.
ML_EXPECTED_MODEL_VERSION=
ML_EXPECTED_MODEL_SHA256=

# Feedback ingestion. Leave path blank to accept feedback without persisting.
ML_FEEDBACK_LOG_PATH=train/data/fit_feedback_runtime.jsonl
ML_FEEDBACK_MAX_PAYLOAD_CHARS=16384

# Batched recommendations.
ML_RECOMMEND_BATCH_MAX_ITEMS=32
ML_RECOMMEND_BATCH_TIMEOUT_SECONDS=8

# Build provenance, surfaced via /version.
ML_GIT_SHA=
ML_BUILD_LABEL=

# Optional local model registry directory used by `python -m train.train_model`.
# When set, every successful training run also copies the artifact + metadata +
# MANIFEST.sha256 into `${ML_MODEL_REGISTRY_DIR}/${modelVersion}/${trainedAt}/`.
ML_MODEL_REGISTRY_DIR=
