NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>

# Auth
JWT_SECRET=replace-with-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password

# CORS / Client URLs
CLIENT_URL=https://www.yourstore.com
ADMIN_URL=https://admin.yourstore.com
FRONTEND_URL=https://www.yourstore.com
CORS_ORIGINS=https://www.yourstore.com,https://admin.yourstore.com

# Cloudinary
CLOUDINARY_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-secret-key

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_TEMPLATE_ORDER_PLACED=order_placed
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=order_out_for_delivery
WHATSAPP_TEMPLATE_DELIVERED=order_delivered
WHATSAPP_TEMPLATE_LANGUAGE_CODE=en_US
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-whatsapp-webhook-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_NOTIFICATION_LOCK_TTL_MS=90000
WHATSAPP_MAX_RETRIES=2

# Loyalty / Referral
LOYALTY_ORDER_POINTS_DIVISOR=100
LOYALTY_MIN_ORDER_REWARD_POINTS=3
REVIEW_REWARD_POINTS=25
REFERRAL_REWARD_REFERRER=30
REFERRAL_REWARD_NEW_USER=20
LOYALTY_POINT_VALUE=1
LOYALTY_MIN_REDEEM_POINTS=50
LOYALTY_MAX_REDEEM_SHARE=0.5
LOYALTY_MAX_REDEEM_POINTS_PER_ORDER=500
LOYALTY_MAX_REDEEM_POINTS_PER_PRODUCT=30

# Marketing / Email
MARKETING_EMAIL_MODE=simulation
MARKETING_EMAIL_PROVIDER=resend
MARKETING_FROM_EMAIL=Lavish Fashion <hello@yourstore.com>
MARKETING_REPLY_TO_EMAIL=support@yourstore.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Realtime (Admin Instant Order Updates)
REALTIME_ENABLED=true
REALTIME_PROVIDER=ably
ABLY_API_KEY=xxxxxxxxxxxxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxx
REALTIME_TOKEN_TTL_MS=600000

# Fit ML service
ML_SERVICE_URL=https://your-ml-service.vercel.app
ML_SERVICE_SHARED_SECRET=replace-with-long-random-secret
ML_SERVICE_TIMEOUT_MS=4000



# Required to enable Shiprocket
SHIPROCKET_ENABLED=true
SHIPROCKET_EMAIL=your_shiprocket_login_email
SHIPROCKET_PASSWORD=your_shiprocket_login_password
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=your_pickup_location_name




extras
SHIPROCKET_TIMEOUT_MS=10000
SHIPROCKET_TOKEN_TTL_MS=86400000
SHIPROCKET_TOKEN_REFRESH_AFTER_MS=82800000

SHIPROCKET_DEFAULT_LENGTH_CM=30
SHIPROCKET_DEFAULT_BREADTH_CM=20
SHIPROCKET_DEFAULT_HEIGHT_CM=8
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
# Shiprocket webhook auth
SHIPROCKET_WEBHOOK_API_KEY=myWebhookSecret123
# Legacy fallback values still supported if you already use them:
SHIPROCKET_WEBHOOK_SECRET=your_long_random_secret
SHIPROCKET_WEBHOOK_TOKEN=your_long_random_token

# Vercel cron auth for the Shiprocket queue drainer
CRON_SECRET=myCronSecret456

# Optional Shiprocket webhook drain tuning
SHIPROCKET_WEBHOOK_DRAIN_BATCH_SIZE=25
SHIPROCKET_WEBHOOK_DRAIN_TIME_BUDGET_MS=15000
SHIPROCKET_WEBHOOK_DRAIN_LOCK_TTL_MS=45000
SHIPROCKET_WEBHOOK_PROCESSING_STALE_AFTER_MS=300000
