NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>

# Auth
JWT_SECRET=replace-with-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password

# CORS / Client URLs
CLIENT_URL=https://www.yourstore.com
ADMIN_URL=https://admin.yourstore.com
FRONTEND_URL=https://www.yourstore.com
CORS_ORIGINS=https://www.yourstore.com,https://admin.yourstore.com

# Cloudinary
CLOUDINARY_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-secret-key

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Loyalty / Referral
LOYALTY_ORDER_POINTS_DIVISOR=100
LOYALTY_MIN_ORDER_REWARD_POINTS=3
REVIEW_REWARD_POINTS=25
REFERRAL_REWARD_REFERRER=30
REFERRAL_REWARD_NEW_USER=20
LOYALTY_POINT_VALUE=1
LOYALTY_MIN_REDEEM_POINTS=50
LOYALTY_MAX_REDEEM_SHARE=0.5
LOYALTY_MAX_REDEEM_POINTS_PER_ORDER=500
LOYALTY_MAX_REDEEM_POINTS_PER_PRODUCT=30

# Marketing / Email
MARKETING_EMAIL_MODE=simulation
MARKETING_EMAIL_PROVIDER=resend
MARKETING_FROM_EMAIL=Lavish Fashion <hello@yourstore.com>
MARKETING_REPLY_TO_EMAIL=support@yourstore.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Realtime (Admin Instant Order Updates)
REALTIME_ENABLED=true
REALTIME_PROVIDER=ably
ABLY_API_KEY=xxxxxxxxxxxxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxx
REALTIME_TOKEN_TTL_MS=600000

# Fit ML service
ML_SERVICE_URL=https://your-ml-service.vercel.app
ML_SERVICE_SHARED_SECRET=replace-with-long-random-secret
ML_SERVICE_TIMEOUT_MS=4000
